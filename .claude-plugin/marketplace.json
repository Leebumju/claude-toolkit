      "version": "0.1.0",
      "author": {
        "name": "Leebumju"
      },
      "keywords": [
        "review",
        "read-only",
        "agent"
      ],
      "category": "workflow"
    },
    {
      "name": "hiring-assignment",
      "source": "./plugins/hiring-assignment",
      "description": "채용 과제 전형용. 시작 30분 절차, 제출 직전 기계 검사, 채점자 관점 적대적 평가",
      "version": "0.1.0",
      "author": {
        "name": "Leebumju"
      },
